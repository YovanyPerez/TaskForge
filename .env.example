# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_NAME=taskforge
DATABASE_USER=taskforge
DATABASE_PASSWORD=taskforge
DATABASE_HOST=localhost

# Email (password reset) — Gmail by default. Use a 16-char App Password,
# never the Google account password. Leave EMAIL_HOST_PASSWORD empty in this
# template; set it only in the git-ignored .env.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Session / cookie security. Leave at 0 for plain-HTTP LAN use and set to 1
# once the app is served over HTTPS.
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Comma-separated extra origins trusted for CSRF (e.g. the Tailscale name):
# CSRF_TRUSTED_ORIGINS=https://taskforge.example.ts.net
CSRF_TRUSTED_ORIGINS=

# Brute-force lockout (django-axes)
AXES_ENABLED=1
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
